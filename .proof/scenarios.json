{
  "repository": "brunnojob/fuckup",
  "inputs": [
    ".proof/scenarios.json",
    ".proof/demo.mjs"
  ],
  "cases": [
    {
      "name": "npm ci",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm ci"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "npm test",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm test"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "npm run typecheck",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm run typecheck"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "npm run build",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm run build"
      ],
      "timeout": 900,
      "display": true
    },
    {
      "name": "Calculate resolution metrics from closed issue records",
      "argv": [
        "node",
        ".proof/demo.mjs"
      ],
      "contains": [],
      "timeout": 120
    }
  ]
}
